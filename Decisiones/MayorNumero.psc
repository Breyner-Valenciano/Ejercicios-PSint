Algoritmo MayorNumero
    Definir n1, n2, mayor Como Entero

    Escribir "Ingrese el primer número: "
    Leer n1

    Escribir "Ingrese el segundo número: "
    Leer n2

    Si n1 > n2 Entonces
        mayor <- n1
    SiNo
        mayor <- n2
    FinSi

    Escribir "El mayor entre ", n1, " y ", n2, " es ", mayor
FinAlgoritmo
